# ==================================================
# ALPHA AI Assistant - Environment Configuration Example
# ==================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file with real secrets!

# Groq API Configuration (Required)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b

# Fish Audio Configuration (Optional - for high quality TTS)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free

# LangSearch API Configuration (Optional - for web search integration)
LANGSEARCH_API_KEY=your_langsearch_api_key_here

# Backend Server Configuration
SERVER_PORT=3001
