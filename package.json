{
  "name": "alpha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"FASTAPI,CLIENT\" -c \"cyan,magenta\" \"python -m uvicorn server.main:app --host 127.0.0.1 --port 3001 --reload\" \"vite --open\"",
    "server": "python -m uvicorn server.main:app --host 127.0.0.1 --port 3001 --reload",
    "client": "vite --open",
    "build": "tsc -b && vite build",
    "start": "python -m uvicorn server.main:app --host 0.0.0.0 --port 3001",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
